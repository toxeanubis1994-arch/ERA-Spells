ZVSE2

; Garrison layout adapted from Reinforcements Spell by daemon_n (MIT).
!#DC(TOX_REINFORCEMENTS_DLG) = 934;
!#DC(TOX_REINFORCEMENTS_ID) = 104;
!#DC(TOX_REINFORCEMENTS_TITLE) = 45;
!#DC(TOX_REINFORCEMENTS_HINT) = 55;
!#DC(TOX_REINFORCEMENTS_TOWN_PORTRAIT) = 52;
!#DC(TOX_REINFORCEMENTS_GARRISON_PORTRAIT) = 51;
!#DC(TOX_REINFORCEMENTS_HERO_PORTRAIT) = 50;
!#DC(TOX_REINFORCEMENTS_CANCEL) = 30721;
!#DC(TOX_REINFORCEMENTS_OK) = 30722;

!?FU(TOX_Reinforcements_Dialog);
!#VA(hero:x) (town:x) (garrison:x);
!#VA(townName:z) (header:z) (townType:y) (fort:y) (frame:y) (dll:y) (transfer:y);
!!FU&i^tox_reinforcements_open^:E;
!!SN:L^EraPlugins\ToxAdventureSpells.era^/?(dll);
!!FU&(dll)=0:E;
!!SN:A(dll)/^ToxAdventureSpells_TransferReinforcements^/?(transfer);
!!FU&(transfer)=0:E;
!!DL(TOX_REINFORCEMENTS_DLG):N^tox_reinf.txt^;
!!FU&-1:E;

!!VRi^tox_reinforcements_hero^:S(hero);
!!VRi^tox_reinforcements_town^:S(town);
!!VRi^tox_reinforcements_garrison^:S(garrison);
!!VRi^tox_reinforcements_transfer^:S(transfer);
!!VRi^tox_reinforcements_source^:S(NO_MON);
!!CA0/(town):N?(townName) R?(fort) T?(townType);
!!SN:T^ToxeosNative.Reinforcements.Garrison^/?(header)/^townName^/(townName);
!!DL(TOX_REINFORCEMENTS_DLG):A(TOX_REINFORCEMENTS_TITLE)/(DLG_CMD_SET_TEXT)/(header)/0;
!!FU(TOX_Reinforcements_Portrait):P(hero)/(TOX_REINFORCEMENTS_HERO_PORTRAIT);
!!if&(garrison)=(NO_HERO);
  !!VR(frame):S(townType) *2 +(fort);
  !!DL(TOX_REINFORCEMENTS_DLG):A(TOX_REINFORCEMENTS_TOWN_PORTRAIT)/(DLG_CMD_SET_DEF_FRAME)/(frame)/0 E(TOX_REINFORCEMENTS_GARRISON_PORTRAIT)/0;
!!el;
  !!DL(TOX_REINFORCEMENTS_DLG):E(TOX_REINFORCEMENTS_TOWN_PORTRAIT)/0;
  !!FU(TOX_Reinforcements_Portrait):P(garrison)/(TOX_REINFORCEMENTS_GARRISON_PORTRAIT);
!!en;
!!FU(TOX_Reinforcements_Refresh):P;
!!VRi^tox_reinforcements_open^:S(TRUE);
!!DL(TOX_REINFORCEMENTS_DLG):S;
!!VRi^tox_reinforcements_open^:S(FALSE);
!!VRi^tox_reinforcements_hero^:S(NO_HERO);
!!VRi^tox_reinforcements_town^:S-1;
!!VRi^tox_reinforcements_garrison^:S(NO_HERO);
!!VRi^tox_reinforcements_transfer^:S(NULL);
!!VRi^tox_reinforcements_source^:S(NO_MON);

!?FU(TOX_Reinforcements_Portrait);
!#VA(hero:x) (item:x) (record:y) (namePtr:y) (name:z);
; Same portrait record and field as the donor dialog.
!!VR(record):S(hero) *92 +8144112;
!!UN:C(record)/4/4/?(namePtr);
!!SN:B(namePtr)/d/?(name);
!!DL(TOX_REINFORCEMENTS_DLG):A(item)/(DLG_CMD_SET_PCX)/(name)/0;

!?FU(TOX_Reinforcements_ReadSlot);
!#VA(bottom:x) (slot:x) (mon:x) (count:x);
!!if&(bottom);
  !!HEi^tox_reinforcements_hero^:C0/(slot)/?(mon)/?(count);
!!el&i^tox_reinforcements_garrison^<>(NO_HERO);
  !!HEi^tox_reinforcements_garrison^:C0/(slot)/?(mon)/?(count);
!!el;
  !!CA0/i^tox_reinforcements_town^:M2/(slot)/?(mon)/?(count);
!!en;

!?FU(TOX_Reinforcements_Refresh);
!#VA(row:y) (slot:y) (mon:y) (count:y) (item:y) (textItem:y) (frame:y) (label:z) (hint:z);
!!re (row)/0/1;
  !!re (slot)/0/(ARMY_SLOT_LAST);
    !!FU(TOX_Reinforcements_ReadSlot):P(row)/(slot)/?(mon)/?(count);
    !!VR(item):S(row) *21 +(slot) +(slot) +(slot) +1;
    !!VR(textItem):S(item) +1;
    !!VR(frame):S0;
    !!VR(label):S^^;
    !!if&(mon)<>(NO_MON)/(count)>0;
      !!VR(frame):S(mon) +2;
      !!VR(label):S^%(count)^;
      !!VR(label)&(row)=0/i^tox_reinforcements_source^=(slot):S^[%(count)]^;
    !!en;
    !!DL(TOX_REINFORCEMENTS_DLG):A(item)/(DLG_CMD_SET_DEF_FRAME)/(frame)/0 A(textItem)/(DLG_CMD_SET_TEXT)/(label)/0;
  !!en;
!!en;
!!if&i^tox_reinforcements_source^=(NO_MON);
  !!SN:T^ToxeosNative.Reinforcements.ChooseStack^/?(hint);
!!el;
  !!SN:T^ToxeosNative.Reinforcements.ChooseDestination^/?(hint);
!!en;
!!DL(TOX_REINFORCEMENTS_DLG):A(TOX_REINFORCEMENTS_HINT)/(DLG_CMD_SET_TEXT)/(hint)/0;

!?FU(OnCustomDialogEvent)&i^dlg_id^=(TOX_REINFORCEMENTS_DLG)/i^dlg_action^=(DLG_ACTION_INDLG_CLICK)/i^tox_reinforcements_open^;
!#VA(item:y) (slot:y) (mon:y) (count:y) (result:y) (oldV1:y);
!!FU&i^mouse_action^<>(MOUSE_LMB_RELEASED):E;
!!VR(item):Si^mouse_item^;
!!if|(item)=(TOX_REINFORCEMENTS_OK)/(item)=(TOX_REINFORCEMENTS_CANCEL);
  !!DL:C1;
  !!FU:E;
!!en;
!!FU|(item)<1/(item)>42:E;
!!if&(item)<=21;
  !!VR(slot):S(item) -1 :3;
  !!FU(TOX_Reinforcements_ReadSlot):P0/(slot)/?(mon)/?(count);
  !!VRi^tox_reinforcements_source^:S(NO_MON);
  !!VRi^tox_reinforcements_source^&(mon)<>(NO_MON)/(count)>0:S(slot);
!!el;
  !!FU&i^tox_reinforcements_source^=(NO_MON):E;
  !!VR(slot):S(item) -22 :3;
  !!VR(oldV1):Sv1;
  !!SN:Ei^tox_reinforcements_transfer^/(CALLCONV_STDCALL)/i^tox_reinforcements_source^/(slot);
  !!VR(result):Sv1;
  !!VRv1:S(oldV1);
  !!if&(result)=1;
    !!DL(TOX_REINFORCEMENTS_DLG):E(TOX_REINFORCEMENTS_CANCEL)/0;
  !!el&(result)=-2;
    !!IF:M^%T(ToxeosNative.Reinforcements.LastStack)^;
  !!el&(result)=-1;
    !!IF:M^%T(ToxeosNative.Reinforcements.WrongTarget)^;
  !!el&(result)=-3;
    !!IF:M^%T(ToxeosNative.Reinforcements.Cost)^;
  !!en;
  !!VRi^tox_reinforcements_source^:S(NO_MON);
!!en;
!!FU(TOX_Reinforcements_Refresh):P;
